services:
  shippingmall-auth-api:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: shippingmall-auth-api
    ports:
      - "8000:8000"
    volumes:
      - ./src:/app/src
    working_dir: /app/src
    command: >
      uvicorn main:app --host 0.0.0.0 --port 8000 --reload

